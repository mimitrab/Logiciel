# Variables à définir chez l'hébergeur (jamais dans le dépôt).

# Fourni automatiquement par l'extension PostgreSQL de Scalingo (SCALINGO_POSTGRESQL_URL) ;
# ailleurs, renseignez DATABASE_URL.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/saccades

# Production : HTTPS obligatoire, cookie de session sécurisé.
NODE_ENV=production

# Premier compte super-administrateur, créé au premier démarrage si la base est vide.
# Mot de passe provisoire de 12 caractères au moins, à changer à la première connexion.
ADMIN_IDENTIFIANT=admin
ADMIN_MOT_DE_PASSE=

# Facultatif : certificat de l'autorité de la base, pour vérifier la connexion chiffrée.
# DATABASE_CA_CERT=
