# Variables à définir chez l'hébergeur (jamais dans le dépôt).

# Fourni automatiquement par l'extension PostgreSQL de Scalingo (SCALINGO_POSTGRESQL_URL) ;
# ailleurs, renseignez DATABASE_URL.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/saccades

# Production : HTTPS obligatoire, cookie de session sécurisé.
NODE_ENV=production

# Votre compte de propriétaire de la plateforme, créé au premier démarrage.
# Mot de passe provisoire de 12 caractères au moins, à changer à la première connexion,
# puis supprimez cette variable.
PROPRIETAIRE_IDENTIFIANT=proprietaire
PROPRIETAIRE_MOT_DE_PASSE=

# Adresse publique du site (sert aux retours du paiement en ligne).
# URL_PUBLIQUE=https://saccades.votre-domaine.fr

# Paiement en ligne par Stripe (facultatif : sans ces clés, vous enregistrez les paiements à la main).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Facultatif : certificat de l'autorité de la base, pour vérifier la connexion chiffrée.
# DATABASE_CA_CERT=
